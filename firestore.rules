rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.email == "matysallanet@gmail.com" || request.auth.uid == "admin");
    }

    // Helper to check if user owns or is member of a document
    function isDocOwner(docData) {
      return request.auth != null && (
        docData == null || 
        (docData.data.projectId == null && (
          docData.data.userId == request.auth.uid || 
          docData.data.creatorId == request.auth.uid || 
          docData.data.ownerId == request.auth.uid ||
          (docData.data.allowedUsers != null && request.auth.uid in docData.data.allowedUsers)
        )) ||
        (docData.data.projectId != null && docData.data.allowedUsers != null && request.auth.uid in docData.data.allowedUsers)
      );
    }

    // Accounts collection
    match /accounts/{accountId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    // Debts collection
    match /debts/{debtId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    // Project Debts collection
    match /project_debts/{debtId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    // Wishlist collection
    match /wishlist/{wishId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    match /wishlists/{wishId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    // Imports collection
    match /imports/{importId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    // Pockets collection
    match /pockets/{pocketId} {
      allow read, write: if request.auth != null && (isDocOwner(resource) || isAdmin());
    }

    // Friendships collection
    match /friendships/{friendshipId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if request.auth != null && (
        resource == null || 
        resource.data.ownerId == request.auth.uid || 
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) || 
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid || 
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) || 
        isAdmin()
      );
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Users Metadata
    match /users_meta/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
